{
	# Panel de administración de Caddy desactivado.
	admin off
}

# SITE_ADDRESS: ":80" en desarrollo; el dominio real (ej. "willwebs.cl") en producción -> TLS automático.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		# La CSP del sitio la emite el frontend (Nginx) con los hashes de los scripts
		# inline generados en el build; la de la API se define abajo.
		{$HSTS_HEADER}
	}

	request_body {
		max_size 1MB
	}

	handle /api/* {
		# La API solo devuelve JSON: nada que cargar ni embeber. (Swagger en dev: directo en API_PORT_LOCAL.)
		header ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy backend:8000 {
			header_up X-Request-ID {http.request.uuid}
		}
	}

	handle {
		reverse_proxy frontend:8080
	}
}
