# Copiar a .env (nunca versionar .env).  En producción las contraseñas van en ./secrets/, no aquí.

APP_ENV=development

# Proxy
SITE_ADDRESS=:80
HTTP_PORT=8088

# MySQL
MYSQL_DATABASE=willwebs
MYSQL_ROOT_PASSWORD=cambia-esto-root
MIGRATOR_DB_USER=willwebs_migrator
MIGRATOR_DB_PASSWORD=cambia-esto-migrator
APP_DB_USER=willwebs_app
APP_DB_PASSWORD=cambia-esto-app
DB_PORT_LOCAL=3307
API_PORT_LOCAL=8001

# API
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ORIGINS=http://localhost:5173

# Correo (dev: Mailpit en http://localhost:8025). En prod SMTP_PASSWORD va en secrets/smtp_password.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_STARTTLS=false
MAIL_FROM=Will-Webs <no-reply@localhost>
LEADS_NOTIFY_TO=leads@localhost

# Anti-bot (Cloudflare Turnstile). Vacío = desactivado (solo dev). En prod: secrets/turnstile_secret_key
TURNSTILE_SECRET_KEY=
# Clave de sitio (pública) para el widget del formulario. Vacía = sin widget.
VITE_TURNSTILE_SITE_KEY=

# URL canónica del sitio (SEO: canonical, og:url). Obligatoria en el build de producción.
VITE_SITE_URL=
