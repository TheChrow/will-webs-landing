# Copiar a .env (nunca versionar .env).  En producción las contraseñas van en ./secrets/, no aquí.

APP_ENV=development

# Proxy
SITE_ADDRESS=:80
HTTP_PORT=8088

# MySQL
MYSQL_DATABASE=willwebs
MYSQL_ROOT_PASSWORD=cambia-esto-root
MIGRATOR_DB_USER=willwebs_migrator
MIGRATOR_DB_PASSWORD=cambia-esto-migrator
APP_DB_USER=willwebs_app
APP_DB_PASSWORD=cambia-esto-app
DB_PORT_LOCAL=3307

# API
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ORIGINS=http://localhost:5173
